  <!-- Navigation -->
  <header>
    <div class="nav-container">
      <a href="#" class="brand">
        <span class="brand-badge">NEB CLASS 12</span>
        <h1>English Grammar Lab</h1>
      </a>
      <nav>
        <ul>
          <li><a href="#rules" class="active">Core Rules</a></li>
          <li><a href="#neb-traps">NEB Exam Traps</a></li>
