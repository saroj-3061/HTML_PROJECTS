    ];

    // Render questions to DOM
    function renderQuestions(filter = 'all') {
      const container = document.getElementById('qaContainer');
      container.innerHTML = '';
      
      const filtered = filter === 'all' 
        ? questionsData 
        : questionsData.filter(item => item.cat === filter);

      filtered.forEach(item => {
        const card = document.createElement('div');
        card.className = 'qa-card searchable';
        card.innerHTML = `
          <div class="qa-header">
            <span class="qa-sentence">${item.id}. ${item.q}</span>
            <button class="btn-reveal" onclick="toggleAnswer(${item.id})">Reveal Answer</button>
          </div>
          <div class="qa-answer" id="ans-${item.id}">
            <strong>Answer:</strong> <span class="highlight-tag">${item.a}</span>
            <div class="qa-reason">💡 ${item.reason}</div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function toggleAnswer(id) {
      const el = document.getElementById(`ans-${id}`);
      el.classList.toggle('visible');
    }

    function switchCategory(cat) {
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');
      renderQuestions(cat);
    }

    // Search filter across cards and practice items
    function filterContent() {
      const input = document.getElementById('ruleSearch').value.toLowerCase();
      const allCards = document.querySelectorAll('.searchable');

      allCards.forEach(card => {
        const text = card.textContent.toLowerCase();
        if (text.includes(input)) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    }

    // Interactive Quiz Engine
    const quizQuestions = [
      {
        q: "Sheep eat green grass,",
        options: ["doesn't it?", "don't they?", "doesn't sheep?", "do they?"],
        correct: 1,
        exp: "'Sheep' is plural because the verb is 'eat' (V1). Plural subject takes 'they' and 'don't'."
      },
      {
        q: "You'd better not take a hard drink,",
        options: ["wouldn't you?", "had you?", "hadn't you?", "would you?"],
        correct: 1,
        exp: "'d better = had better. It is followed by 'not', so the tag is positive: 'had you?'."
      },
      {
        q: "Nobody called me while I was away,",
        options: ["didn't they?", "did he?", "did they?", "weren't they?"],
        correct: 2,
        exp: "'Nobody' is negative and turns into pronoun 'they'. Past simple requires 'did they?'."
      },
      {
        q: "I am late for the assembly,",
        options: ["am I?", "amn't I?", "aren't I?", "isn't I?"],
        correct: 2,
        exp: "Standard English requires 'aren't I?' for positive 'I am'."
      },
      {
        q: "Let us go to the library now, sir,",
        options: ["shall we?", "will you?", "can we?", "won't we?"],
        correct: 1,
        exp: "'Let us' asking for permission from a superior takes 'will you?'."
      },
      {
        q: "He is impolite to all his elders,",
        options: ["is he?", "isn't he?", "doesn't he?", "was he?"],
        correct: 1,
        exp: "Prefixes like 'im-' do not make a clause grammatically negative. The tag remains negative: 'isn't he?'."
      },
      {
        q: "She barely passed the final examination,",
        options: ["didn't she?", "did she?", "hasn't she?", "does she?"],
        correct: 1,
        exp: "'Barely' expresses negative polarity, so the tag is positive: 'did she?'."
      },
      {
        q: "I don't think he will pass the test,",
        options: ["won't he?", "will he?", "do I?", "don't I?"],
        correct: 1,
        exp: "Transferred negation with 'I don't think' makes the whole proposition negative: 'will she/he?'."
      },
      {
        q: "Hari used to live in France,",
        options: ["usedn't he?", "didn't he?", "doesn't he?", "did he?"],
        correct: 1,
        exp: "'Used to' expresses past habitual aspect and uses 'did/didn't'."
      },
      {
        q: "Don't let him swim in that dangerous pond,",
        options: ["shall we?", "will you?", "can't you?", "do you?"],
        correct: 1,
        exp: "Negative imperatives starting with 'Don't' always take 'will you?'."
      }
    ];

    let currentQuizIndex = 0;
    let quizScore = 0;

    function loadQuizQuestion() {
      const q = quizQuestions[currentQuizIndex];
      document.getElementById('currentQNum').innerText = currentQuizIndex + 1;
      document.getElementById('totalQNum').innerText = quizQuestions.length;
      document.getElementById('quizSentence').innerText = `${currentQuizIndex + 1}. ${q.q} ________?`;
      
      const optContainer = document.getElementById('quizOptions');
      optContainer.innerHTML = '';
      
      const feedback = document.getElementById('quizFeedback');
      feedback.style.display = 'none';
      document.getElementById('nextQuizBtn').style.display = 'none';

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-btn';
        btn.innerText = opt;
        btn.onclick = () => selectQuizAnswer(idx);
        optContainer.appendChild(btn);
      });
    }

    function selectQuizAnswer(idx) {
      const q = quizQuestions[currentQuizIndex];
      const buttons = document.querySelectorAll('.quiz-btn');
      const feedback = document.getElementById('quizFeedback');

      buttons.forEach(b => b.disabled = true);

      if (idx === q.correct) {
        buttons[idx].classList.add('correct');
        quizScore++;
        document.getElementById('scoreCount').innerText = quizScore;
        feedback.innerHTML = `<span style="color: #34d399;">✅ Correct!</span> ${q.exp}`;
      } else {
        buttons[idx].classList.add('wrong');
        buttons[q.correct].classList.add('correct');
        feedback.innerHTML = `<span style="color: #f87171;">❌ Incorrect!</span> Correct answer is <strong>${q.options[q.correct]}</strong>. ${q.exp}`;
      }
      
      feedback.style.display = 'block';
      document.getElementById('nextQuizBtn').style.display = 'inline-block';
    }

    function loadNextQuestion() {
      currentQuizIndex++;
      if (currentQuizIndex < quizQuestions.length) {
        loadQuizQuestion();
      } else {
        // Quiz finished
        document.getElementById('quizQuestionArea').innerHTML = `
          <div style="text-align: center; padding: 2rem 0;">
            <h3 style="font-size: 2rem; color: #fff; margin-bottom: 0.5rem;">Quiz Completed! 🎉</h3>
            <p style="font-size: 1.25rem; color: #cbd5e1; margin-bottom: 1.5rem;">Your Final NEB Readiness Score: <strong style="color: #38bdf8;">${quizScore} / ${quizQuestions.length}</strong></p>
            <p style="color: #94a3b8; max-width: 500px; margin: 0 auto 1.5rem;">${quizScore >= 8 ? 'Outstanding! You have exceptional mastery of question tag nuances.' : 'Good effort! Review the NEB Exam Traps section above and retry.'}</p>
            <button class="btn-reveal" style="padding: 0.75rem 1.5rem; font-size: 1rem;" onclick="resetQuiz()">Restart Quiz</button>
          </div>
        `;
        document.getElementById('nextQuizBtn').style.display = 'none';
      }
    }

    function resetQuiz() {
      currentQuizIndex = 0;
      quizScore = 0;
      document.getElementById('scoreCount').innerText = '0';
      document.getElementById('quizQuestionArea').innerHTML = `
        <h3 id="quizSentence" style="font-size: 1.35rem; margin-bottom: 1.5rem; font-weight: 700;"></h3>
        <div class="quiz-options" id="quizOptions"></div>
        <div id="quizFeedback" style="margin-top: 1rem; font-weight: 600; display: none;"></div>
      `;
      loadQuizQuestion();
    }

    // Initial setup
    window.addEventListener('DOMContentLoaded', () => {
      renderQuestions('all');
      loadQuizQuestion();
    });
  </script>
</body>
</html>





        
